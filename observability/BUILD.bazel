load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@observability_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages()

exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
])

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.ts"]) + [
        "package.json",
        "tsconfig.json",
    ],
)

js_library(
    name = "pkg",
    srcs = [":sources"],
    deps = [
        ":node_modules/@grafana/grafana-foundation-sdk",
        ":node_modules/yaml",
    ],
)

js_test(
    name = "lint",
    args = [
        "oxlint",
        "oxlint",
        "observability",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_js_ts_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "observability",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_json_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "observability/package.json",
        "observability/tsconfig.json",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_binary(
    name = "tsx_bin",
    chdir = package_name(),
    data = [":node_modules"],
    entry_point = "scripts/run-tsx.mjs",
)

js_run_binary(
    name = "generated_config",
    srcs = [
        ":node_modules",
        ":pkg",
    ],
    args = ["src/generate.ts"],
    chdir = package_name(),
    env = {
        "OBSERVABILITY_OUT_DIR": "generated",
    },
    out_dirs = ["generated"],
    tool = ":tsx_bin",
)

js_test(
    name = "generation_plan_test",
    args = ["src/generate.test.ts"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":pkg",
    ],
    entry_point = "scripts/run-tsx.mjs",
)

sh_test(
    name = "generated_config_test",
    srcs = ["check-generated.sh"],
    data = [":generated_config"],
)

js_test(
    name = "typecheck",
    args = [
        "--noEmit",
        "--project",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
    entry_point = "scripts/run-tsc.mjs",
)
