+    const std::vector<uint8_t> hashPayload(4 * 1024 * 1024, 'm');
+    BENCHMARK("BBFComponent - XXH3-128 (4MB payload)")
+    {
+        const XXH128_hash_t hash = XXH3_128bits(hashPayload.data(), hashPayload.size());
+        volatile uint64_t checksum = hash.low64 ^ hash.high64;
+        return checksum;
+    };
+
+    const std::vector<uint8_t> writePayload(4 * 1024 * 1024, 'm');
+    BENCHMARK("BBFComponent - Write Payload (4MB)")
+    {
+        std::ofstream output("component-write.bbf", std::ios::binary | std::ios::trunc);
+        output.write(reinterpret_cast<const char*>(writePayload.data()), writePayload.size());
+        output.close();
+        volatile uint64_t checksum = writePayload.size();
+        return checksum;
+    };
+    deleteFile("component-write.bbf");
+
+    BBFAssetTable dedupLookup;
+    const XXH128_hash_t dedupHash = XXH3_128bits(hashPayload.data(), hashPayload.size());
+    dedupLookup.addAsset(dedupHash, 7);
+    BENCHMARK("BBFComponent - Dedup Lookup (4MB hash)")
+    {
+        return dedupLookup.findAsset(dedupHash);
+    };
+
+    const size_t indexPageCount = (4 * 1024 * 1024) / sizeof(BBFPage);
+    std::vector<BBFPage> indexPages(indexPageCount);
+    for (size_t iterator = 0; iterator < indexPageCount; ++iterator)
+    {
+        indexPages[iterator].assetIndex = iterator % 17;
+        indexPages[iterator].flags = static_cast<uint32_t>(iterator) & 3;
+    }
+    BENCHMARK("BBFComponent - Page Index Encode+Hash (4MB)")
+    {
+        std::vector<uint8_t> encoded(indexPages.size() * sizeof(BBFPage));
+        std::copy(
+            reinterpret_cast<const uint8_t*>(indexPages.data()),
+            reinterpret_cast<const uint8_t*>(indexPages.data()) + encoded.size(),
+            encoded.begin());
+        const uint64_t hash = XXH3_64bits(encoded.data(), encoded.size());
+        volatile uint64_t checksum = hash;
+        return checksum;
+    };
+
+    BENCHMARK("BBFComponent - Cached Page Index Hash (4MB)")
+    {
+        const uint64_t hash = XXH3_64bits(indexPages.data(), indexPages.size() * sizeof(BBFPage));
+        volatile uint64_t checksum = hash;
+        return checksum;
+    };
+
