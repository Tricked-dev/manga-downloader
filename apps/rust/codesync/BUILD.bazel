load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

_CODESYNC_DEPS = [
    "@backend_crates//:allocative-0.3.6",
    "@backend_crates//:anyhow",
    "@backend_crates//:clap",
    "@backend_crates//:gix",
    "@backend_crates//:serde",
    "@backend_crates//:serde_json",
    "@backend_crates//:starlark",
    "@backend_crates//:tempfile",
]

rust_library(
    name = "codesync_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "codesync",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = _CODESYNC_DEPS,
)

rust_binary(
    name = "codesync",
    srcs = ["src/main.rs"],
    crate_name = "codesync_cli",
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [":codesync_lib"],
)

rust_test(
    name = "test_codesync",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/codesync.rs",
    edition = "2024",
    deps = [
        ":codesync_lib",
        "@backend_crates//:anyhow",
        "@backend_crates//:tempfile",
    ],
)

rust_quality_targets(
    targets = [
        ":codesync",
        ":codesync_lib",
        ":test_codesync",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = [
        "BUILD.bazel",
        "examples/codesync.star",
    ],
    tags = ["starlark"],
)
