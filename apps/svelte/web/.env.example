# Backend that the SvelteKit frontend proxies /api/app requests to.
# Change this to the host or IP where `manga-server serve` is reachable.
BACKEND_URL=http://127.0.0.1:4000

# Optional: send a bearer token when the backend requires API auth.
# BACKEND_API_KEY=

# Advanced deployments can split the server-side and browser-visible origins.
# BACKEND_INTERNAL_URL=http://127.0.0.1:4000
# PUBLIC_API_BASE=http://127.0.0.1:4000
