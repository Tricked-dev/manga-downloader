{
  "name": "@manga-server/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || true",
    "build": "vp build",
    "build:analyze": "ANALYZE=true vp build",
    "build:cloudflare": "pnpm run build",
    "bench": "vitest bench --run",
    "preview:cloudflare": "pnpm run build && wrangler dev",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "deploy:cloudflare:dry-run": "node scripts/deploy-cloudflare.mjs --dry-run",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@manga-server/api-client": "workspace:*",
    "@manga-server/ui": "workspace:*",
    "@tanstack/query-async-storage-persister": "5.100.14",
    "@tanstack/query-core": "5.100.14",
    "@tanstack/query-persist-client-core": "5.100.14",
    "@tanstack/svelte-query": "catalog:",
    "@tanstack/svelte-query-devtools": "6.1.33",
    "@tanstack/svelte-table": "9.0.0-alpha.50",
    "@tanstack/svelte-virtual": "3.13.26",
    "better-auth": "1.6.13",
    "better-sqlite3": "12.10.0",
    "sveltekit-i18n": "2.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260531.1",
    "@internationalized/date": "3.12.2",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/ui": "4.1.7",
    "bits-ui": "2.18.1",
    "clsx": "catalog:",
    "layerchart": "2.0.0-next.64",
    "playwright": "1.60.0",
    "sonda": "0.11.1",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "2.1.1",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.1.3"
}
