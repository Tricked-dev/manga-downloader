load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//apps/svelte/web:svelte-check/package_json.bzl", svelte_check = "bin")
load("@npm//apps/svelte/web:vite-plus/package_json.bzl", vite_plus = "bin")
load("@npm//apps/svelte/web:wrangler/package_json.bzl", wrangler = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages()

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)

filegroup(
    name = "sources",
    srcs = glob([
        "src/**",
        "static/**",
        "scripts/**",
        "*.js",
        "*.json",
        "*.toml",
        "*.ts",
    ]),
)

js_library(
    name = "pkg",
    srcs = [":sources"],
    deps = [
        ":node_modules/@lucide/svelte",
        ":node_modules/@manga-server/api-client",
        ":node_modules/@manga-server/ui",
        ":node_modules/@tanstack/query-async-storage-persister",
        ":node_modules/@tanstack/query-core",
        ":node_modules/@tanstack/query-persist-client-core",
        ":node_modules/@tanstack/svelte-query",
        ":node_modules/@tanstack/svelte-query-devtools",
        ":node_modules/@tanstack/svelte-table",
        ":node_modules/@tanstack/svelte-virtual",
        ":node_modules/better-auth",
        ":node_modules/better-sqlite3",
        ":node_modules/sveltekit-i18n",
        ":node_modules/zod",
        "//libs/svelte/api-client:pkg",
    ],
)

js_test(
    name = "lint",
    args = [
        "oxlint",
        "oxlint",
        "apps/svelte/web",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_js_ts_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "apps/svelte/web",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_json_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "apps/svelte/web/components.json",
        "apps/svelte/web/package.json",
        "apps/svelte/web/tsconfig.json",
        "apps/svelte/web/src/lib/i18n/locales/de/app.json",
        "apps/svelte/web/src/lib/i18n/locales/en/app.json",
        "apps/svelte/web/src/lib/i18n/locales/es/app.json",
        "apps/svelte/web/src/lib/i18n/locales/fr/app.json",
        "apps/svelte/web/src/lib/i18n/locales/it/app.json",
        "apps/svelte/web/src/lib/i18n/locales/pl/app.json",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

vite_plus.vp(
    name = "build",
    srcs = [
        ":node_modules",
        ":pkg",
        "//:node_modules/vite-plus",
        "//third_party/rust:Cargo.toml",
    ],
    args = ["build"],
    chdir = package_name(),
    copy_srcs_to_bin = False,
    out_dirs = [".svelte-kit"],
)

svelte_check.svelte_check_test(
    name = "typecheck",
    args = [
        "--tsconfig",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":build",
        ":node_modules",
        ":sources",
        "//:node_modules",
        "//:node_modules/vite-plus",
        "//:root_oxc_files",
    ],
)

vite_plus.vp_test(
    name = "test",
    args = [
        "test",
        "run",
        "--project",
        "unit",
    ],
    chdir = package_name(),
    data = [
        ":build",
        ":node_modules",
        ":sources",
        "//:node_modules",
        "//:node_modules/vite-plus",
        "//:root_oxc_files",
    ],
    env = {
        "NODE_PATH": "../../../node_modules",
    },
)

vite_plus.vp_test(
    name = "browser_test",
    args = [
        "test",
        "run",
        "--project",
        "browser",
    ],
    chdir = package_name(),
    data = [
        ":build",
        ":node_modules",
        ":sources",
        "//:node_modules",
        "//:node_modules/vite-plus",
        "//:root_oxc_files",
    ],
    env = {
        "NODE_PATH": "../../../node_modules",
    },
    tags = [
        "manual",
        "requires-browser",
    ],
)

vite_plus.vp_binary(
    name = "dev",
    args = [
        "dev",
        "--host",
        "0.0.0.0",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
        "//:node_modules",
        "//:node_modules/vite-plus",
        "//:root_oxc_files",
    ],
    env = {
        "NODE_PATH": "../../../node_modules",
    },
    tags = ["manual"],
)

wrangler.wrangler_binary(
    name = "deploy_cloudflare",
    args = ["deploy"],
    chdir = package_name(),
    data = [
        ":build",
        ":node_modules",
    ],
    tags = [
        "manual",
        "requires-network",
    ],
)

wrangler.wrangler_binary(
    name = "deploy_cloudflare_dry_run",
    args = [
        "deploy",
        "--dry-run",
    ],
    chdir = package_name(),
    data = [
        ":build",
        ":node_modules",
    ],
    tags = [
        "manual",
        "requires-network",
    ],
)
