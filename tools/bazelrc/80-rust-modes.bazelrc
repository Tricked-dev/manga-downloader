common:release --copt=-O3
common:release --copt=-ffast-math
common:release --features=thin_lto
common:release --linkopt=-pthread
common:release --@rules_rust//:extra_rustc_flags=-Ctarget-feature="+sse4.2"
common:release --@rules_rust//:extra_rustc_flags=-Ctarget-feature="+avx512f"
common:release --@rules_rust//:extra_rustc_flags=-Ctarget-feature="+avx512ifma"
common:release --@rules_rust//:extra_rustc_flags=-Cstrip=symbols
common:release --@rules_rust//:extra_rustc_flags=-Cpanic=abort
common:release --@rules_rust//:extra_rustc_flags=-Copt-level=3
common:release --@rules_rust//rust/settings:lto=thin
common:release --@rules_rust//rust/settings:codegen_units=1

common:asan --@rules_rust//rust/settings:extra_rustc_env=RUSTC_BOOTSTRAP=1
common:asan --@rules_rust//:extra_rustc_flag=-Zsanitizer=address
common:asan --test_env=RUST_BACKTRACE=1

common:lsan --@rules_rust//rust/settings:extra_rustc_env=RUSTC_BOOTSTRAP=1
common:lsan --@rules_rust//:extra_rustc_flag=-Zsanitizer=leak
common:lsan --test_env=RUST_BACKTRACE=1

common --cxxopt='-std=c++20'
common --host_cxxopt='-std=c++20'