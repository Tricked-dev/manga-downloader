########################
# Forward-compatibility defaults.
#
# Source of truth:
# - Bazel command-line reference, Nightly / 10.0.0-pre surface.
# - bazelbuild/bazel at d62d21b378c23e86692bd249161c29b15d33bb4d, matching
#   the selected Bazel binary in this workspace.
# - `bazel canonicalize-flags` plus `bazel build --nobuild //:gazelle_bin`.
#
# Keep all accepted boolean `--incompatible_*` build flags enabled when they do
# not break the current external rule graph. Commented flags below were checked
# and fail today, so they are left as the explicit follow-up queue.
common --incompatible_allow_tags_propagation
common --incompatible_always_check_depset_elements
common --incompatible_always_include_files_in_data
common --incompatible_bazel_test_exec_run_under
common --incompatible_bep_cpu_from_platform
common --incompatible_builtin_objc_strip_action
common --incompatible_check_testonly_for_output_files
common --incompatible_compact_repo_mapping_manifest
common --incompatible_config_setting_private_default_visibility
common --incompatible_disable_legacy_cc_provider
common --incompatible_disable_nocopts
common --incompatible_disable_non_executable_java_binary
common --incompatible_disable_objc_library_transition
common --incompatible_disable_starlark_host_transitions
common --incompatible_disallow_ctx_resolve_tools
common --incompatible_disallow_empty_glob
common --incompatible_disallow_java_import_exports
common --incompatible_disallow_sdk_frameworks_attributes
common --incompatible_do_not_split_linking_cmdline
common --incompatible_dont_enable_host_nonhost_crosstool_features
common --incompatible_enable_cc_toolchain_resolution
common --incompatible_enable_deprecated_label_apis
common --incompatible_enable_proto_toolchain_resolution
common --incompatible_enforce_config_setting_visibility
common --incompatible_enforce_starlark_utf8
common --incompatible_exclude_starlark_flags_from_exec_config
common --incompatible_exclusive_test_sandboxed
common --incompatible_fail_on_unknown_attributes
common --incompatible_filegroup_runfiles_for_data
common --incompatible_fix_package_group_reporoot_syntax
common --incompatible_java_info_merge_runtime_module_flags
common --incompatible_locations_prefers_executable
common --incompatible_merge_genfiles_directory
common --incompatible_modify_execution_info_additive
common --incompatible_multi_release_deploy_jars
common --incompatible_no_attr_license
common --incompatible_no_implicit_file_export
common --incompatible_no_implicit_watch_label
common --incompatible_objc_alwayslink_by_default
common --incompatible_package_group_has_public_syntax
common --incompatible_remote_local_fallback_for_remote_cache
common --incompatible_remove_ctx_android_fragment
common --incompatible_remove_ctx_objc_fragment
common --incompatible_remove_legacy_whole_archive
common --incompatible_repo_env_ignores_action_env
common --incompatible_resolve_select_keys_eagerly
common --incompatible_run_shell_command_string
common --incompatible_simplify_unconditional_selects_in_rule_attrs
common --incompatible_skip_genfiles_symlink
common --incompatible_stop_exporting_language_modules
common --incompatible_strict_action_env
common --incompatible_strip_executable_safely
common --incompatible_target_cpu_from_platform
common --incompatible_unambiguous_label_stringification
common --incompatible_use_cpp_compile_header_mnemonic
common --incompatible_use_new_cgroup_implementation
common --incompatible_use_specific_tool_files
common --incompatible_use_toolchain_resolution_for_java_rules

# Query-only incompatible defaults from the same Bazel source/doc surface.
query --incompatible_lexicographical_output
query --incompatible_package_group_build_output
query --incompatible_package_group_includes_double_slash

# Accepted by Bazel 10.0.0-pre-d62d21b, but not possible yet in this repo.
# common --incompatible_auto_exec_groups
#   Fails in protobuf's prebuilt protoc authenticity action: run_shell needs an
#   explicit toolchain parameter.
# common --incompatible_disable_target_default_provider_fields
#   Fails in protobuf's proto toolchain rule: accesses files_to_run through the
#   default provider field syntax.
# common --incompatible_no_rule_outputs_param
#   Fails in rules_cc: cc_binary still declares rule(outputs = ...).
# common --incompatible_remove_ctx_apple_fragment
#   Fails in hermetic-llvm's macOS toolchain args: macos_minimum_os_flag still
#   reads ctx.fragments.apple.macos_minimum_os_flag.
# common --incompatible_require_mnemonic_for_run_actions
#   Fails in hermetic-llvm's glibc stub generation: ctx.actions.run lacks an
#   explicit mnemonic.
# common --incompatible_stop_exporting_build_file_path
#   Fails in bazel-lib's run_binary path used by hermetic-llvm libcxx runtimes:
#   it still reads ctx.build_file_path.

# Value-taking incompatible flags are not simple boolean strict-mode toggles.
# common --incompatible_autoload_externally=<symbol=repo,...>
# common --incompatible_disable_select_on=<flag,...>
# common --incompatible_disable_transitions_on=<flag,...>
# common --incompatible_limit_platforms_in_output_dir_to=<label,...>

# Removed or renamed relative to older incompatible.bazelrc examples.
# --incompatible_check_sharding_support is no longer accepted.
# --incompatible_disable_native_android_rules is no longer accepted; the current
#   source flag is --incompatible_disable_native_apple_binary_rule.
