########################
# BuildBuddy remote execution and BES
#
# Auth is supplied by BuildBuddy CLI login, environment, or local git config.
common --bes_results_url=https://cyclops.buildbuddy.io/invocation/
common --bes_backend=grpcs://cyclops.buildbuddy.io
common --remote_cache=grpcs://cyclops.buildbuddy.io
common --remote_executor=grpcs://cyclops.buildbuddy.io
common --remote_downloader=grpcs://cyclops.buildbuddy.io
common --remote_timeout=3600
common --remote_cache_compression=true
common --jobs=800
common --remote_download_toplevel
common --noslim_profile
common --experimental_profile_include_primary_output
common --experimental_profile_include_target_label=true
common --experimental_repo_remote_exec
common --bes_upload_mode=fully_async
common --remote_build_event_upload=all
common --experimental_remote_cache_chunking