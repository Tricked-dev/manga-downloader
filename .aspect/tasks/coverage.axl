"""Coverage Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)

def _coverage_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//apps/rust/...", "//libs/rust/..."])
    return run_bazel(ctx, ["coverage"] + targets)

coverage = task(
    group = ["repo"],
    implementation = _coverage_impl,
    summary = "Run Bazel coverage for backend targets by default.",
    args = {
        "targets": args.positional(
            default = ["//apps/rust/...", "//libs/rust/..."],
            description = "Bazel targets to run coverage for.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _coverage_repo_owned_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [FILESYSTEM_TEST_TARGET])
    return run_bazel(ctx, [
        "coverage",
        "--host_platform=" + RBE_REPO_OWNED_EXECUTION_PLATFORM,
        "--extra_execution_platforms=" + RBE_REPO_OWNED_EXECUTION_PLATFORM,
    ] + targets)

coverage_repo_owned = task(
    group = ["repo"],
    implementation = _coverage_repo_owned_impl,
    summary = "Run coverage on the repo-owned GHCR RBE image.",
    args = {
        "targets": args.positional(
            default = [FILESYSTEM_TEST_TARGET],
            description = "Bazel targets to run coverage for on the repo-owned RBE image.",
            maximum = 128,
            minimum = 0,
        ),
    },
)
