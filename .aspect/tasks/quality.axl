"""Quality Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)

def _format_check_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, [
        ["build", "//:format_check"],
        ["test", "//:rustfmt_test"],
        ["test", "//:format_oxc_check"],
    ])

format_check = task(
    group = ["repo"],
    implementation = _format_check_impl,
    summary = "Run the Bazel-backed formatter checks.",
    args = {},
)

def _lint_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, [
        ["test", "//:lint"],
        ["build", "//:clippy_check"],
    ])

lint = task(
    group = ["repo"],
    implementation = _lint_impl,
    summary = "Run the Bazel-backed lint suite.",
    args = {},
)

def _cargo_deny_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//libs/bazel/cargo:cargo_deny"])

cargo_deny = task(
    group = ["repo"],
    implementation = _cargo_deny_impl,
    summary = "Run cargo-deny through Bazel-built tooling.",
    args = {},
)

def _cargo_shear_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//libs/bazel/cargo:cargo_shear"])

cargo_shear = task(
    group = ["repo"],
    implementation = _cargo_shear_impl,
    summary = "Run cargo-shear through Bazel-built tooling.",
    args = {},
)

def _cargo_manifest_policy_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//libs/bazel/cargo:cargo_manifest_policy"])

cargo_manifest_policy = task(
    group = ["repo"],
    implementation = _cargo_manifest_policy_impl,
    summary = "Verify Cargo manifest and lock files exist only under third_party/rust.",
    args = {},
)

def _cargo_policy_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build"] + CARGO_POLICY_TARGETS)

cargo_policy = task(
    group = ["repo"],
    implementation = _cargo_policy_impl,
    summary = "Verify centralized Cargo files and hermetic Bazel-built cargo tool wiring.",
    args = {},
)

def _cargo_tools_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build"] + CARGO_TOOL_TARGETS)

cargo_tools = task(
    group = ["repo"],
    implementation = _cargo_tools_impl,
    summary = "Build the Bazel-managed cargo-deny and cargo-shear tool actions.",
    args = {},
)

def _policy_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build"] + BAZEL_POLICY_TARGETS + CARGO_POLICY_TARGETS)

policy = task(
    group = ["repo"],
    implementation = _policy_impl,
    summary = "Verify Bazel toolchain, remote cache, BuildBuddy workflow, and Gazelle policy checks.",
    args = {},
)

def _quality_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, QUALITY_STEPS)

quality = task(
    group = ["repo"],
    implementation = _quality_impl,
    summary = "Run Gazelle drift, Bazel policy, format, lint, Cargo policy, k6, and SBOM checks.",
    args = {},
)

def _sbom_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//:backend_sbom_graph"])

sbom = task(
    group = ["repo"],
    implementation = _sbom_impl,
    summary = "Build the backend SBOM graph target.",
    args = {},
)
