"""Runtime Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)

def _flamegraph_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["run", "--config=release", FLAMEGRAPH_SERVER_TARGET, "--"] + ctx.args.args)

flamegraph = task(
    group = ["repo"],
    implementation = _flamegraph_impl,
    summary = "Profile the Bazel-built Rust server with the Bazel-built flamegraph tool.",
    args = {
        "args": args.positional(
            default = [],
            description = "Arguments forwarded to //apps/rust/server:server under flamegraph.",
            maximum = 64,
            minimum = 0,
        ),
    },
)

def _bb_clientd_prepare_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//libs/bazel/buildbarn:bb_clientd_config"])

bb_clientd_prepare = task(
    group = ["repo"],
    implementation = _bb_clientd_prepare_impl,
    summary = "Check the repo bb_clientd config target before starting the daemon.",
    args = {},
)

def _bb_clientd_build_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [BACKEND_SERVER_TARGET])
    return run_bazel(ctx, ["build", "--config=bb-clientd"] + targets)

bb_clientd_build = task(
    group = ["repo"],
    implementation = _bb_clientd_build_impl,
    summary = "Build targets through a running bb_clientd proxy.",
    args = {
        "targets": args.positional(
            default = [BACKEND_SERVER_TARGET],
            description = "Bazel targets to build through --config=bb-clientd.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _release_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [BACKEND_SERVER_TARGET])
    return run_bazel(ctx, ["build", "--config=release"] + targets)

release = task(
    group = ["repo"],
    implementation = _release_impl,
    summary = "Build optimized release targets with remote defaults.",
    args = {
        "targets": args.positional(
            default = [BACKEND_SERVER_TARGET],
            description = "Bazel targets to build with --config=release.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _asan_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [FILESYSTEM_TEST_TARGET])
    return run_bazel(ctx, ["test", "--config=asan"] + targets)

asan = task(
    group = ["repo"],
    implementation = _asan_impl,
    summary = "Run selected Rust tests with AddressSanitizer instrumentation.",
    args = {
        "targets": args.positional(
            default = [FILESYSTEM_TEST_TARGET],
            description = "Bazel test targets to run with --config=asan.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _lsan_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [FILESYSTEM_TEST_TARGET])
    return run_bazel(ctx, ["test", "--config=lsan"] + targets)

lsan = task(
    group = ["repo"],
    implementation = _lsan_impl,
    summary = "Run selected Rust tests with LeakSanitizer instrumentation.",
    args = {
        "targets": args.positional(
            default = [FILESYSTEM_TEST_TARGET],
            description = "Bazel test targets to run with --config=lsan.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _sanitizers_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, [FILESYSTEM_TEST_TARGET])
    return run_steps(ctx, [
        ["test", "--config=asan"] + targets,
        ["test", "--config=lsan"] + targets,
    ])

sanitizers = task(
    group = ["repo"],
    implementation = _sanitizers_impl,
    summary = "Run selected Rust tests under ASan and LSan.",
    args = {
        "targets": args.positional(
            default = [FILESYSTEM_TEST_TARGET],
            description = "Bazel test targets to run with ASan and LSan.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _optimized_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, OPTIMIZED_STEPS)

optimized = task(
    group = ["repo"],
    implementation = _optimized_impl,
    summary = "Build release mode and run sanitizer canaries.",
    args = {},
)

def _start_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["run", "//apps/rust/dev-start:start", "--"] + ctx.args.args)

start = task(
    group = ["repo"],
    implementation = _start_impl,
    summary = "Start the backend and frontend through the Bazel dev launcher.",
    args = {
        "args": args.positional(
            default = [],
            description = "Arguments forwarded to //apps/rust/dev-start:start.",
            maximum = 32,
            minimum = 0,
        ),
    },
)

def _bench_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//libs/rust/fs:bench_filesystem_scans"])
    code = run_bazel(ctx, ["build"] + targets)
    if code != 0 or ctx.args.build_only:
        return code
    return run_steps(ctx, [["run", target] for target in targets])

bench = task(
    group = ["repo"],
    implementation = _bench_impl,
    summary = "Build or run Criterion benchmark binaries.",
    args = {
        "build_only": args.boolean(
            default = False,
            description = "Only build benchmark binaries; do not run them.",
        ),
        "targets": args.positional(
            default = ["//libs/rust/fs:bench_filesystem_scans"],
            description = "Criterion benchmark targets to build or run.",
            maximum = 64,
            minimum = 0,
        ),
    },
)

def _k6_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//stress-testing:api_smoke"])
    return run_steps(ctx, [["run", target] for target in targets])

k6 = task(
    group = ["repo"],
    implementation = _k6_impl,
    summary = "Run k6 Bazel runner targets.",
    args = {
        "targets": args.positional(
            default = ["//stress-testing:api_smoke"],
            description = "k6 Bazel runner targets to execute.",
            maximum = 32,
            minimum = 0,
        ),
    },
)
