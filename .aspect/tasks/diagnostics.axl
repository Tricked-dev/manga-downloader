)

def _canonical_flags_impl(ctx: TaskContext) -> int:
    flags = targets_or_default(ctx.args.flags, CANONICAL_FLAG_DEFAULTS)
    return run_bazel(ctx, ["canonicalize-flags", "--"] + flags)

canonical_flags = task(
    group = ["repo"],
    implementation = _canonical_flags_impl,
    summary = "Canonicalize Bazel flags for rc and policy debugging.",
    args = {
        "flags": args.positional(
            default = CANONICAL_FLAG_DEFAULTS,
            description = "Bazel flags to canonicalize after --.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

