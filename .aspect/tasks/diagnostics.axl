def _profile_impl(ctx: TaskContext) -> int:
    if not ensure_cache_dir(ctx):
        return 1
    targets = targets_or_default(ctx.args.targets, ["//libs/bazel/bazelrc:remote_cache_policy"])
    return run_bazel(ctx, [
        "build",
        "--profile=" + PROFILE_PATH,
        "--experimental_profile_include_target_label",
        "--experimental_profile_include_target_configuration",
    ] + targets)

profile = task(
    group = ["repo"],
    implementation = _profile_impl,
    summary = "Capture a Bazel JSON trace profile for analysis and execution timing.",
    args = {
        "targets": args.positional(
            default = ["//libs/bazel/bazelrc:remote_cache_policy"],
            description = "Bazel targets to build while capturing .cache/bazel/profile.json.gz.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _build_events_impl(ctx: TaskContext) -> int:
    if not ensure_cache_dir(ctx):
        return 1
    targets = targets_or_default(ctx.args.targets, ["//libs/bazel/bazelrc:remote_cache_policy"])
    code = run_bazel(ctx, [
        "build",
        "--build_event_json_file=" + BUILD_EVENTS_RAW_PATH,
        "--build_event_publish_all_actions",
        "--experimental_bep_target_summary",
        "--experimental_record_metrics_for_all_mnemonics",
    ] + targets)
    if code != 0:
        return code

    _redact_build_events(ctx)

    remove = ctx.std.process.command("rm").arg("-f").arg(BUILD_EVENTS_RAW_PATH)
    remove_result = remove.spawn().wait()
    return 0 if remove_result.success else 1

def _redact_build_events(ctx: TaskContext):
    redacted = ctx.std.fs.read_to_string(BUILD_EVENTS_RAW_PATH)
    for prefix in BUILD_EVENTS_SECRET_PREFIXES:
        redacted = _redact_after_prefix(redacted, prefix)
    ctx.std.fs.write(BUILD_EVENTS_PATH, redacted)

def _redact_after_prefix(text: str, prefix: str) -> str:
    parts = text.split(prefix)
    chunks = [parts[0]]
    for part in parts[1:]:
        value_end = _secret_value_end(part)
        chunks.append(prefix)
        chunks.append("<redacted>")
        chunks.append(part[value_end:])
    return "".join(chunks)

def _secret_value_end(text: str) -> int:
    for cursor in range(len(text)):
        if _is_secret_terminator(text[cursor]):
            return cursor
    return len(text)

def _is_secret_terminator(ch: str) -> bool:
    return ch in [
        "\"",
        "'",
        "\\",
        ",",
        "]",
        "}",
        " ",
        "\n",
        "\r",
        "\t",
    ]

build_events = task(
    group = ["repo"],
    implementation = _build_events_impl,
    summary = "Capture a local Build Event Protocol JSON stream for build diagnostics.",
    args = {
        "targets": args.positional(
            default = ["//libs/bazel/bazelrc:remote_cache_policy"],
            description = "Bazel targets to build while capturing .cache/bazel/build-events.json.",
            maximum = 128,
            minimum = 0,
        ),
    },
)
