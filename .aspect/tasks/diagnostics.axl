def _cache_probe_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//libs/bazel/bazelrc:remote_cache_policy"])
    return run_bazel(ctx, [
        "build",
        "--experimental_remote_require_cached",
        "--noremote_upload_local_results",
    ] + targets)

cache_probe = task(
    group = ["repo"],
    implementation = _cache_probe_impl,
    summary = "Verify selected targets are already in remote cache without uploading new results.",
    args = {
        "targets": args.positional(
            default = ["//libs/bazel/bazelrc:remote_cache_policy"],
            description = "Bazel targets to require from remote cache.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _exec_log_impl(ctx: TaskContext) -> int:
    if not ensure_cache_dir(ctx):
        return 1
    targets = targets_or_default(ctx.args.targets, ["//libs/bazel/bazelrc:remote_cache_policy"])
    return run_bazel(ctx, [
        "build",
        "--execution_log_compact_file=" + EXEC_LOG_PATH,
    ] + targets)

exec_log = task(
    group = ["repo"],
    implementation = _exec_log_impl,
    summary = "Capture a compact Bazel execution log for cache debugging.",
    args = {
        "targets": args.positional(
            default = ["//libs/bazel/bazelrc:remote_cache_policy"],
            description = "Bazel targets to build while capturing .cache/bazel/execution-log.compact.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

