"""Doctor Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)
load(".aspect/tasks/rbe.axl", "run_default_rbe_image_canary")

def _doctor_impl(ctx: TaskContext) -> int:
    return _run_doctor(ctx)

def _run_doctor(ctx: TaskContext) -> int:
    code = run_steps(ctx, DOCTOR_PREFLIGHT_STEPS)
    if code != 0:
        return code
    code = run_default_rbe_image_canary(ctx)
    if code != 0:
        return code
    return run_steps(ctx, DOCTOR_VALIDATION_STEPS)

doctor = task(
    group = ["repo"],
    implementation = _doctor_impl,
    summary = "Check Bazel version, Bazel policy, Linux target analysis, host run analysis, and RBE image analysis.",
    args = {},
)

def _repo_check_impl(ctx: TaskContext) -> int:
    code = _run_doctor(ctx)
    if code != 0:
        return code
    return run_steps(ctx, [
        ["build", "//..."],
        ["test", "//..."],
        ["coverage", "//apps/rust/...", "//libs/rust/..."],
    ] + QUALITY_STEPS + [
        ["build", RBE_IMAGE_TARGET],
    ])

repo_check = task(
    group = ["repo"],
    implementation = _repo_check_impl,
    summary = "Run the broad Bazel migration verification suite.",
    args = {},
)
