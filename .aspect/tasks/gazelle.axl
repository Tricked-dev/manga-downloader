"""Gazelle Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)

def _gazelle_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["run", "//:gazelle"] + ctx.args.args)

gazelle = task(
    group = ["repo"],
    implementation = _gazelle_impl,
    summary = "Run Gazelle with the JS/TS, Rust, Go, and proto language plugins.",
    args = {
        "args": args.positional(
            default = [],
            description = "Arguments forwarded to Gazelle after the Bazel run target.",
            maximum = 128,
            minimum = 0,
        ),
    },
)

def _gazelle_build_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["build", "//:gazelle_bin"])

gazelle_build = task(
    group = ["repo"],
    implementation = _gazelle_build_impl,
    summary = "Build the configured source-built Gazelle binary without modifying BUILD files.",
    args = {},
)

def _gazelle_check_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, GAZELLE_DIFF_STEP)

gazelle_check = task(
    group = ["repo"],
    implementation = _gazelle_check_impl,
    summary = "Verify Gazelle-generated BUILD files without modifying them.",
    args = {},
)

def _mod_deps_check_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["mod", "deps", "--lockfile_mode=error"])

mod_deps_check = task(
    group = ["repo"],
    implementation = _mod_deps_check_impl,
    summary = "Verify MODULE.bazel.lock is current without updating it.",
    args = {},
)

def _mod_deps_update_impl(ctx: TaskContext) -> int:
    return run_bazel(ctx, ["mod", "deps", "--lockfile_mode=update"])

mod_deps_update = task(
    group = ["repo"],
    implementation = _mod_deps_update_impl,
    summary = "Update MODULE.bazel.lock after Bzlmod dependency changes.",
    args = {},
)
