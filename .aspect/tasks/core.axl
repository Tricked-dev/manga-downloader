"""Core Aspect tasks."""

load(
    ".aspect/libs/repo.axl",
    "ACTION_GRAPH_DEFAULTS",
    "BACKEND_SERVER_TARGET",
    "BAZEL_POLICY_TARGETS",
    "BUILD_EVENTS_PATH",
    "BUILD_EVENTS_RAW_PATH",
    "BUILD_EVENTS_SECRET_PREFIXES",
    "CANONICAL_FLAG_DEFAULTS",
    "CARGO_POLICY_TARGETS",
    "CARGO_TOOL_TARGETS",
    "CONFIGURED_TARGET_DEFAULTS",
    "DEV_START_TARGET",
    "DOCTOR_PREFLIGHT_STEPS",
    "DOCTOR_VALIDATION_STEPS",
    "EXEC_LOG_PATH",
    "FILESYSTEM_TEST_TARGET",
    "FLAMEGRAPH_SERVER_TARGET",
    "GAZELLE_DIFF_STEP",
    "K6_TARGETS",
    "OPTIMIZED_STEPS",
    "PROFILE_PATH",
    "QUALITY_STEPS",
    "RBE_DEFAULT_IMAGE_CANARY_TARGET",
    "RBE_IMAGE_TARGET",
    "RBE_PUSH_TARGET",
    "RBE_REPO_OWNED_EXECUTION_PLATFORM",
    "RBE_REPO_OWNED_IMAGE_CANARY_TARGET",
    "REMOTE_GRPC_LOG_PATH",
    "ensure_cache_dir",
    "run_bazel",
    "run_bb",
    "run_steps",
    "targets_or_default",
)

def _build_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//..."])
    return run_bazel(ctx, ["build"] + targets)

build = task(
    group = ["repo"],
    implementation = _build_impl,
    summary = "Build Bazel targets with the repo remote defaults.",
    args = {
        "targets": args.positional(
            default = ["//..."],
            description = "Bazel targets to build.",
            maximum = 256,
            minimum = 0,
        ),
    },
)

def _test_impl(ctx: TaskContext) -> int:
    targets = targets_or_default(ctx.args.targets, ["//..."])
    return run_bazel(ctx, ["test"] + targets)

test = task(
    group = ["repo"],
    implementation = _test_impl,
    summary = "Test Bazel targets with the repo remote defaults.",
    args = {
        "targets": args.positional(
            default = ["//..."],
            description = "Bazel targets to test.",
            maximum = 256,
            minimum = 0,
        ),
    },
)

def _backend_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, [
        ["build", "//apps/rust/...", "//libs/rust/..."],
        ["test", "//apps/rust/...", "//libs/rust/..."],
    ])

backend = task(
    group = ["repo"],
    implementation = _backend_impl,
    summary = "Build and test backend Bazel targets.",
    args = {},
)

def _frontend_impl(ctx: TaskContext) -> int:
    return run_steps(ctx, [
        ["build", "//apps/svelte:apps", "//libs/svelte:libs"],
        ["test", "//apps/svelte:tests", "//libs/svelte:tests"],
    ])

frontend = task(
    group = ["repo"],
    implementation = _frontend_impl,
    summary = "Build and test frontend Bazel targets.",
    args = {},
)
