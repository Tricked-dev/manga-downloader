"""Shared helpers and constants for manga-downloader Aspect tasks."""

def run_bazel(ctx: TaskContext, args: list[str]) -> int:
    cmd = ctx.std.process.command("bazel")
    for arg in args:
        cmd = cmd.arg(arg)
    result = cmd.spawn().wait()
    return 0 if result.success else 1

def run_bb(ctx: TaskContext, args: list[str]) -> int:
    cmd = ctx.std.process.command("bb")
    for arg in args:
        cmd = cmd.arg(arg)
    result = cmd.spawn().wait()
    return 0 if result.success else 1

def targets_or_default(targets: list[str], default: list[str]) -> list[str]:
    return targets if targets else default

def ensure_cache_dir(ctx: TaskContext) -> bool:
    result = ctx.std.process.command("mkdir").arg("-p").arg(".cache/bazel").spawn().wait()
    return result.success

def run_steps(ctx: TaskContext, steps: list[list[str]]) -> int:
    for step in steps:
        code = run_bazel(ctx, step)
        if code != 0:
            return code
    return 0

