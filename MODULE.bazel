module(
    name = "manga_downloader",
    version = "0.1.0",
)

bazel_dep(name = "aspect_rules_js", version = "3.1.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.10")
bazel_dep(name = "aspect_gazelle_js", version = "1.0.1")
bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "gazelle_rust", version = "0.1.0")
bazel_dep(name = "libgit2", version = "1.9.1")
bazel_dep(name = "llvm", version = "0.8.4")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")
bazel_dep(name = "mimalloc", version = "2.2.4.bcr.2")
bazel_dep(name = "package_metadata", version = "0.0.10")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_go", version = "0.61.0")
bazel_dep(name = "rules_java", version = "9.5.0")
bazel_dep(name = "rules_nodejs", version = "6.7.4")
bazel_dep(name = "rules_img", version = "0.2.9")
bazel_dep(name = "rules_apko", version = "1.5.47")
bazel_dep(name = "rules_kotlin", version = "2.3.20")
bazel_dep(name = "rules_rs", version = "0.0.83")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "supply_chain_tools", version = "0.0.1")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "upx_src",
    build_file = "//third_party/upx:BUILD.upx.bazel",
    sha256 = "8eb914115b306fd9fd2110bd3d27ddb8ae7c5a03bb965f7d10f046a3a4ff9dfe",
    strip_prefix = "upx-5.1.1-src",
    urls = ["https://github.com/upx/upx/releases/download/v5.1.1/upx-5.1.1-src.tar.xz"],
)

prebuilt_img_tool = use_extension("@rules_img//img/private/prebuilt:prebuilt.bzl", "prebuilt_img_tool")
prebuilt_img_tool.collection(
    name = "img_toolchain",
    override = True,
)
prebuilt_img_tool.from_file(
    collection = "img_toolchain",
    file = "@rules_img//:prebuilt_lockfile.json",
)
use_repo(
    prebuilt_img_tool,
    "img_toolchain",
)

register_toolchains(
    "@img_toolchain//:img_darwin_amd64_toolchain",
    "@img_toolchain//:img_darwin_arm64_toolchain",
    "@img_toolchain//:img_linux_amd64_toolchain",
    "@img_toolchain//:img_linux_arm64_toolchain",
)

single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//third_party/patches:llvm_libgcc_s_linker_script.patch"],
    version = "0.8.4",
)

single_version_override(
    module_name = "aspect_rules_js",
    version = "3.1.2",
)

#single_version_override(
#    module_name = "rules_apko",
#    patch_strip = 1,
#    patches = ["//third_party/patches:rules_apko_range_header.patch"],
#    version = "1.5.47",
#)

single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = ["//third_party/patches:rules_go_cgo_runtime_link_inputs.patch"],
    version = "0.61.0",
)

llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "linux",
)
use_repo(llvm_toolchain, "llvm_toolchains")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    experimental_build_compiler_from_source = True,
    patch_strip = 1,
    patches = ["//third_party/patches:go_compiler_flags.patch"],
    version = "1.26.3",
)
use_repo(go_sdk, "go_sdk")

buildifier_tools = use_extension("@buildifier_prebuilt//:defs.bzl", "buildifier_prebuilt_deps_extension")
use_repo(buildifier_tools, "buildifier_linux_amd64")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_repositories = {
        "26.2.0-darwin_amd64": ("node-v26.2.0-darwin-x64.tar.gz", "node-v26.2.0-darwin-x64", "26a5480d0dd952be86beae83e6636dacd7a3ffd17ef51d0b26bc9b260f2b42e9"),
        "26.2.0-darwin_arm64": ("node-v26.2.0-darwin-arm64.tar.gz", "node-v26.2.0-darwin-arm64", "2d8575b6a749c0bc66cc6ecd22a952f7d9bbf3b0ea76fcb0ed3ce858018afff7"),
        "26.2.0-linux_amd64": ("node-v26.2.0-linux-x64.tar.xz", "node-v26.2.0-linux-x64", "9f786864128a11375e398b8dfacd4a5e995ec4b6a6c8b3b52ac9afbc95ea8158"),
        "26.2.0-linux_arm64": ("node-v26.2.0-linux-arm64.tar.xz", "node-v26.2.0-linux-arm64", "2f06be7e5435728abd890fe53b69965773919b705d8cfedd856c8f604c1e3726"),
    },
    node_version_from_nvmrc = "//:.nvmrc",
)
use_repo(node, "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    lifecycle_hooks_exclude = ["better-sqlite3"],
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
npm.npm_exclude_package_contents(
    package = "@sveltejs/kit",
    presets = [],
)
npm.npm_translate_lock(
    name = "observability_npm",
    data = [
        "//observability:package.json",
        "//observability:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//observability:pnpm-lock.yaml",
)
use_repo(npm, "npm", "observability_npm")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    name = "manga_rust_toolchains",
    edition = "2024",
    version = "1.94.0",
)
use_repo(toolchains, "default_rust_toolchains", "manga_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@manga_rust_toolchains//:all",
    "@llvm_toolchains//:all",
    "//libs/bazel/bazelrc:default_test_toolchain",
)

apko_toolchain = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko_toolchain.toolchain(apko_version = "v1.2.11")
use_repo(apko_toolchain, "apko_toolchains")

register_toolchains("@apko_toolchains//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.annotation(
    crate = "libz-sys",
    gen_build_script = "off",
    deps = ["@zlib"],
)

# toasty-driver-sqlite 0.7 hardcodes rusqlite's bundled feature, so
# libsqlite3-sys must run its build script to generate bundled bindings.
crate.annotation(
    crate = "libsqlite3-sys",
    gen_build_script = "on",
)
crate.annotation(
    crate = "libgit2-sys",
    gen_build_script = "off",
    deps = ["@libgit2"],
)
crate.annotation(
    crate = "lz4-sys",
    gen_build_script = "off",
    deps = ["@lz4//:lz4_frame"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)
crate.from_cargo(
    name = "backend_crates",
    cargo_lock = "//third_party/rust:Cargo.lock",
    cargo_toml = "//third_party/rust:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "wasm32-wasip2",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)

inject_repo(crate, "libgit2", "lz4", "mimalloc", "zlib", "zstd")

crate.annotation(
    crate = "cargo-deny",
    gen_binaries = ["cargo-deny"],
)
crate.annotation(
    crate = "cargo-shear",
    gen_binaries = ["cargo-shear"],
)
crate.annotation(
    crate = "flamegraph",
    gen_binaries = ["flamegraph"],
)
crate.from_cargo(
    name = "cargo_tools_crates",
    cargo_lock = "//third_party/rust:Cargo.lock",
    cargo_toml = "//third_party/rust:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "backend_crates", "cargo_tools_crates")

apko_lock = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko_lock.translate_lock(
    name = "rbe_apko_lock",
    lock = "//infra/images/rbe:apko.lock.json",
)
use_repo(apko_lock, "rbe_apko_lock")
