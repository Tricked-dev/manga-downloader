load("@rules_rust//rust:defs.bzl", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

rust_shared_library(
    name = "comix_wasm",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//libs/rust/plugin-host:wit_files"],
    crate_name = "comix",
    crate_root = "src/lib.rs",
    edition = "2024",
    platform = "@rules_rs//rs/platforms:wasm32-wasip2",
    deps = [
        "//plugins/crates/manga-plugin-kit",
        "@backend_crates//:base64",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
        "@backend_crates//:wit-bindgen",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(["src/**/*.rs"]),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
