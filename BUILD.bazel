load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@gazelle//:def.bzl", "DEFAULT_LANGUAGES", "gazelle", "gazelle_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@supply_chain_tools//sbom:sbom.bzl", "sbom")

# gazelle:prefix github.com/CyclopsBot/manga-downloader
# gazelle:build_file_name BUILD.bazel
# gazelle:rust_mode generate_from_cargo
# gazelle:rust_default_edition 2024
# gazelle:rust_cargo_lockfile third_party/rust/Cargo.lock
# gazelle:rust_crates_prefix @backend_crates//:
# gazelle:js disabled
# gazelle:js_pnpm_lockfile pnpm-lock.yaml
# gazelle:js_proto disabled
# gazelle:exclude .aspect
# gazelle:exclude .cocoindex_code
# gazelle:exclude .cache
# gazelle:exclude .direnv
# gazelle:exclude .git
# gazelle:exclude bazel-*
# gazelle:exclude data
# gazelle:exclude tmp

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

npm_link_all_packages()

package_metadata(
    name = "package_metadata",
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

_BAZELRC_FRAGMENT_FILES = glob(["tools/bazelrc/*.bazelrc"])

exports_files([
    ".npmrc",
    ".bazelrc",
    ".gitignore",
    "MODULE.bazel",
    "buildbuddy.yaml",
    "docs/bazel.md",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "renovate.json",
    "scripts/run-npm-bin.mjs",
    "user.bazelrc.example",
    "vite.config.ts",
] + _BAZELRC_FRAGMENT_FILES)

filegroup(
    name = "bazelrc_files",
    srcs = [
        ".bazelrc",
    ] + _BAZELRC_FRAGMENT_FILES,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bazel_toolchain_policy_files",
    srcs = [
        ".bazelrc",
        ".gitignore",
        "BUILD.bazel",
        "MODULE.bazel",
        "buildbuddy.yaml",
        "docs/bazel.md",
        "user.bazelrc.example",
        ":aspect_task_policy_files",
        ":bazelrc_files",
        "//infra/images/rbe:starlark_files",
        "//libs/bazel/buildbarn:bb_clientd.buildbuddy.jsonnet",
        "//libs/bazel/quality:starlark_files",
        "//libs/bazel/rust:starlark_files",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "aspect_task_policy_files",
    srcs = glob([".aspect/**/*.axl"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "github_actions_workflow_files",
    srcs = glob(
        [".github/workflows/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

js_library(
    name = "run_npm_bin",
    srcs = ["scripts/run-npm-bin.mjs"],
)

js_library(
    name = "root_oxc_files",
    srcs = [
        "package.json",
        "renovate.json",
        "vite.config.ts",
    ],
)

test_suite(
    name = "rustfmt_test",
    tests = ["//libs/bazel/quality:rustfmt_test"],
)

alias(
    name = "clippy_check",
    actual = "//libs/bazel/quality:clippy_check",
)

filegroup(
    name = "starlark_files",
    srcs = glob([".aspect/**/*.axl"]) + [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["starlark"],
)

filegroup(
    name = "app_library_starlark_files",
    srcs = [
        "//apps:starlark_files",
        "//libs/rust:starlark_files",
        "//libs/svelte:starlark_files",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "workspace_starlark_files",
    srcs = [
        ":starlark_files",
        "//apps:starlark_files",
        "//infra/images/rbe:starlark_files",
        "//libs:starlark_files",
        "//observability:starlark_files",
        "//stress-testing:starlark_files",
        "//third_party:starlark_files",
    ],
    visibility = ["//visibility:public"],
)

genrule(
    name = "format_starlark_check",
    srcs = [
        ":workspace_starlark_files",
    ],
    outs = ["format_starlark_check.ok"],
    cmd = "$(location @buildifier_linux_amd64//:buildifier) -mode=check $(SRCS) && printf 'ok\\n' > $@",
    exec_compatible_with = ["//infra/images/rbe:executor_ghcr"],
    tools = ["@buildifier_linux_amd64//:buildifier"],
)

filegroup(
    name = "format_check",
    srcs = [":format_starlark_check"],
)

filegroup(
    name = "cargo_workspace_files",
    srcs = [
        "//apps/rust/codesync:rust_files",
        "//apps/rust/server:rust_files",
        "//libs/rust/api-types:rust_files",
        "//libs/rust/cache:rust_files",
        "//libs/rust/clearance:rust_files",
        "//libs/rust/config:rust_files",
        "//libs/rust/core:rust_files",
        "//libs/rust/discord:rust_files",
        "//libs/rust/fs:rust_files",
        "//libs/rust/image:rust_files",
        "//libs/rust/page-extraction:rust_files",
        "//libs/rust/persistence:rust_files",
        "//libs/rust/plugin-host:rust_files",
        "//libs/rust/plugin-host:wit_files",
        "//libs/rust/runtime:rust_files",
        "//libs/rust/telemetry:rust_files",
        "//third_party/rust:cargo_files",
    ],
)

test_suite(
    name = "lint",
    tests = ["//libs/bazel/quality:lint"],
)

test_suite(
    name = "format_oxc_js_ts_check",
    tests = ["//libs/bazel/quality:format_oxc_js_ts_check"],
)

test_suite(
    name = "format_oxc_json_check",
    tests = ["//libs/bazel/quality:format_oxc_json_check"],
)

test_suite(
    name = "format_oxc_check",
    tests = ["//libs/bazel/quality:format_oxc_check"],
)

alias(
    name = "start",
    actual = "//apps/rust/dev-start:start",
)

gazelle_binary(
    name = "gazelle_bin",
    languages = DEFAULT_LANGUAGES + [
        "@aspect_gazelle_js//:aspect_gazelle_js",
        "@gazelle_rust//rust_language",
    ],
    tags = ["manual"],
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_bin",
    tags = ["manual"],
)

sbom(
    name = "backend_sbom_graph",
    target = "//apps/rust/server",
)
