load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "vendor_compression",
    srcs = glob([
        "vendor/**/*.h",
        "vendor/ucl/src/*.c",
        "vendor/zlib/*.c",
    ]),
    copts = [
        "-fno-delete-null-pointer-checks",
        "-fno-strict-aliasing",
        "-fno-strict-overflow",
        "-fno-tree-vectorize",
        "-funsigned-char",
        "-Wno-cast-align",
        "-Wno-cast-qual",
        "-Wno-missing-declarations",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        "-Wno-vla",
    ],
    defines = [
        "HAVE_UNISTD_H=1",
        "HAVE_VSNPRINTF=1",
        "UPX_CONFIG_DISABLE_WERROR=1",
        "UPX_CONFIG_DISABLE_WSTRICT=1",
    ],
    includes = [
        "vendor",
        "vendor/ucl",
        "vendor/ucl/include",
        "vendor/zlib",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--allow-multiple-definition"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob([
        "vendor/ucl/src/*.c",
        "vendor/ucl/**/*.ch",
    ]),
)

cc_library(
    name = "vendor_textual",
    includes = ["vendor"],
    textual_hdrs = glob([
        "vendor/lzma-sdk/**/*.c",
        "vendor/lzma-sdk/**/*.cpp",
    ]) + ["vendor/doctest/doctest/parts/doctest.cpp"],
)

cc_binary(
    name = "upx",
    srcs = glob([
        "src/*.cpp",
        "src/**/*.cpp",
        "src/**/*.h",
        "src/**/*.hh",
    ]),
    copts = [
        "-std=c++17",
        "-fno-delete-null-pointer-checks",
        "-fno-strict-aliasing",
        "-fno-strict-overflow",
        "-fno-tree-vectorize",
        "-funsigned-char",
        "-Wno-cast-align",
        "-Wno-cast-qual",
        "-Wno-missing-declarations",
        "-Wno-shadow",
        "-Wno-sign-compare",
        "-Wno-unused-function",
        "-Wno-vla",
    ],
    defines = [
        "HAVE_UNISTD_H=1",
        "HAVE_VSNPRINTF=1",
        "UPX_CONFIG_DISABLE_WERROR=1",
        "UPX_CONFIG_DISABLE_WSTRICT=1",
    ],
    includes = ["vendor"],
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--allow-multiple-definition"],
        "//conditions:default": [],
    }),
    deps = [
        ":vendor_compression",
        ":vendor_textual",
    ],
)
