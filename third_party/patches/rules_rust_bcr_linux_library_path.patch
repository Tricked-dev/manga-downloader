+def _collect_library_paths_from_link_args(link_args):
+    paths = []
+    next_arg_is_path = False
+    for arg in link_args:
+        if next_arg_is_path:
+            if arg:
+                paths.append(arg)
+            next_arg_is_path = False
+            continue
+
+        if arg == "-L":
+            next_arg_is_path = True
+            continue
+
+        if not arg.startswith("-L"):
+            continue
+
+        path = arg[2:]
+        if path.startswith("="):
+            path = path[1:]
+        if path.startswith("native="):
+            path = path[len("native="):]
 
+        if path:
+            paths.append(path)
+
+    return paths
+
+def _prepend_env_paths(env, name, paths, separator):
+    if not paths:
+        return
+
+    value = separator.join(paths)
+    existing = env.get(name)
+    if existing:
+        value = value + separator + existing
+
+    env[name] = value
+
