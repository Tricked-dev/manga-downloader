-
+
+config_setting(
+    name = "empty_sysroot_linux",
+    constraint_values = ["@platforms//os:linux"],
+    flag_values = {
+        "//config:empty_sysroot": "True",
+    },
+)
+
+write_file(
+    name = "empty_linux_libgcc_s",
+    out = "empty_linux_sysroot_sources/lib/libgcc_s.so",
+    content = ["/* Hermetic libgcc_s compatibility stub for musl Rust links. */"],
+)
+
+write_file(
+    name = "empty_linux_usr_libgcc_s",
+    out = "empty_linux_sysroot_sources/usr/lib/libgcc_s.so",
+    content = ["/* Hermetic libgcc_s compatibility stub for musl Rust links. */"],
+)
+
+copy_to_directory(
+    name = "empty_linux_sysroot",
+    srcs = [
+        ":empty_linux_libgcc_s",
+        ":empty_linux_usr_libgcc_s",
+    ],
+    root_paths = ["toolchain/args/empty_linux_sysroot_sources"],
+    target_compatible_with = ["@platforms//os:linux"],
+)
+
 # Passing a sysroot to /dev/null has the side effect of removing all default
 # library search paths that clang passes like -L/usr/lib.
+# On Linux, keep the search paths hermetic while satisfying rustc's early
+# -lgcc_s probe before later source-built runtime -L flags are appended.
 cc_args(
     name = "empty_sysroot_flags",
     actions = [
         "@rules_cc//cc/toolchains/actions:compile_actions",
         "@rules_cc//cc/toolchains/actions:link_actions",
     ],
     args = select({
+        ":empty_sysroot_linux": [
+            "--sysroot={empty_linux_sysroot}",
+        ],
         ":empty_sysroot": [
             "--sysroot=/dev/null",
         ],
         "//conditions:default": [],
     }),
+    data = [
+        ":empty_linux_sysroot",
+    ],
+    format = {
+        "empty_linux_sysroot": ":empty_linux_sysroot",
+    },
 )
