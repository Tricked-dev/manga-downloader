    },
    {
      "type": "table",
      "transparent": false,
      "repeatDirection": "h",
      "id": 16,
      "title": "Recent function errors",
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false,
        "footer": {
          "show": false,
          "reducer": [],
          "countRows": false
        },
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": false,
              "Value": false,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "value"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk($limit, sum by (function, module, service_name, result) (increase(function_calls_total{job=\"$job\", service_name=~\"$service_name\", module=~\"$module\", result=\"error\"}[$__range])) or on(function, module, service_name, result) label_replace(0 * sum by (function, module, service_name) (increase(function_calls_total{job=\"$job\", service_name=~\"$service_name\", module=~\"$module\"}[$__range])), \"result\", \"none\", \"function\", \".*\"))",
          "refId": "A",
          "legendFormat": "{{module}}::{{function}} {{result}}",
          "editorMode": "code",
          "format": "table",
