load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "page-extraction",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_page_extraction",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/fs",
        "//libs/rust/image",
        "//libs/rust/telemetry",
        "@backend_crates//:anyhow",
        "@backend_crates//:rayon",
        "@backend_crates//:tokio",
    ],
)

rust_test(
    name = "test_page_extraction",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/fs",
        "//libs/rust/image",
        "//libs/rust/telemetry",
        "@backend_crates//:anyhow",
        "@backend_crates//:rayon",
        "@backend_crates//:tokio",
        "@backend_crates//:uuid",
    ],
)

rust_quality_targets(
    targets = [
        ":page-extraction",
        ":test_page_extraction",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
