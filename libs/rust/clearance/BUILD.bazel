load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "clearance",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_clearance",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/tls",
        "@backend_crates//:async-tungstenite",
        "@backend_crates//:chromiumoxide",
        "@backend_crates//:futures-util",
        "@backend_crates//:reqwest",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:tokio",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
    ],
)

rust_test(
    name = "test_clearance",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_clearance_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/tls",
        "@backend_crates//:async-tungstenite",
        "@backend_crates//:chromiumoxide",
        "@backend_crates//:futures-util",
        "@backend_crates//:reqwest",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:tokio",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
    ],
)

rust_quality_targets(
    targets = [
        ":clearance",
        ":test_clearance",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
