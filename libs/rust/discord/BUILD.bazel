load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "discord",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_discord",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/core",
        "//libs/rust/persistence",
        "//libs/rust/plugin-host",
        "@backend_crates//:anyhow",
        "@backend_crates//:autometrics",
        "@backend_crates//:jiff",
        "@backend_crates//:secrecy",
        "@backend_crates//:tokio",
        "@backend_crates//:tokio-graceful",
        "@backend_crates//:tracing",
        "@backend_crates//:twilight-gateway",
        "@backend_crates//:twilight-http",
        "@backend_crates//:twilight-interactions",
        "@backend_crates//:twilight-model",
        "@backend_crates//:url",
    ],
)

rust_test(
    name = "test_notifications",
    srcs = ["tests/notifications.rs"],
    crate_root = "tests/notifications.rs",
    edition = "2024",
    deps = [
        ":discord",
        "//libs/rust/core",
        "//libs/rust/persistence",
        "//libs/rust/plugin-host",
        "@backend_crates//:anyhow",
        "@backend_crates//:autometrics",
        "@backend_crates//:jiff",
        "@backend_crates//:secrecy",
        "@backend_crates//:tokio",
        "@backend_crates//:tokio-graceful",
        "@backend_crates//:tracing",
        "@backend_crates//:twilight-gateway",
        "@backend_crates//:twilight-http",
        "@backend_crates//:twilight-interactions",
        "@backend_crates//:twilight-model",
        "@backend_crates//:url",
    ],
)

rust_quality_targets(
    targets = [
        ":discord",
        ":test_notifications",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
