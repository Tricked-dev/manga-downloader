load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "criterion_benchmark", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

exports_files([
    "benches/filesystem_scans.rs",
])

rust_library(
    name = "fs",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_fs",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "@backend_crates//:anyhow",
        "@backend_crates//:fusio",
        "@backend_crates//:futures-util",
        "@backend_crates//:tokio",
    ],
)

rust_test(
    name = "test_filesystem",
    srcs = ["tests/filesystem.rs"],
    crate_root = "tests/filesystem.rs",
    edition = "2024",
    deps = [
        ":fs",
        "@backend_crates//:anyhow",
        "@backend_crates//:criterion",
        "@backend_crates//:fusio",
        "@backend_crates//:futures-util",
        "@backend_crates//:tempfile",
        "@backend_crates//:tokio",
    ],
)

criterion_benchmark(
    name = "bench_filesystem_scans",
    crate_root = "benches/filesystem_scans.rs",
    deps = [
        ":fs",
        "@backend_crates//:criterion",
        "@backend_crates//:tempfile",
    ],
)

rust_quality_targets(
    targets = [
        ":bench_filesystem_scans",
        ":fs",
        ":test_filesystem",
    ],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "benches/**/*.rs",
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
