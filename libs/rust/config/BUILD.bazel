load("@rules_rust//rust:defs.bzl", "rust_library")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_config",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/fs",
        "@backend_crates//:anyhow",
        "@backend_crates//:schematic",
        "@backend_crates//:serde",
    ],
)

rust_quality_targets(
    targets = [":config"],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
