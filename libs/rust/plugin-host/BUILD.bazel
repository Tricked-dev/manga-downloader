load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "plugin-host",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":wit_files"],
    crate_name = "backend_plugin_host",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/clearance",
        "//libs/rust/core",
        "//libs/rust/fs",
        "//libs/rust/image",
        "//libs/rust/tls",
        "@backend_crates//:anyhow",
        "@backend_crates//:base64",
        "@backend_crates//:bytecheck",
        "@backend_crates//:reqwest",
        "@backend_crates//:rkyv",
        "@backend_crates//:semver",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:sha2",
        "@backend_crates//:thiserror",
        "@backend_crates//:tokio",
        "@backend_crates//:tower",
        "@backend_crates//:tower-resilience-coalesce",
        "@backend_crates//:tower-resilience-retry",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
        "@backend_crates//:utoipa",
        "@backend_crates//:wasmtime",
        "@backend_crates//:wasmtime-wasi",
    ],
)

rust_test(
    name = "test_media_spec",
    srcs = ["tests/media_spec.rs"],
    crate_root = "tests/media_spec.rs",
    edition = "2024",
    deps = [
        ":plugin-host",
        "//libs/rust/clearance",
        "//libs/rust/core",
        "//libs/rust/fs",
        "//libs/rust/image",
        "//libs/rust/tls",
        "@backend_crates//:anyhow",
        "@backend_crates//:base64",
        "@backend_crates//:bytecheck",
        "@backend_crates//:reqwest",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:sha2",
        "@backend_crates//:thiserror",
        "@backend_crates//:tokio",
        "@backend_crates//:tower",
        "@backend_crates//:tower-resilience-coalesce",
        "@backend_crates//:tower-resilience-retry",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
        "@backend_crates//:utoipa",
        "@backend_crates//:wasmtime",
        "@backend_crates//:wasmtime-wasi",
    ],
)

rust_test(
    name = "test_plugin_host",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":wit_files"],
    crate_name = "backend_plugin_host_test",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "//libs/rust/clearance",
        "//libs/rust/core",
        "//libs/rust/fs",
        "//libs/rust/image",
        "//libs/rust/tls",
        "@backend_crates//:anyhow",
        "@backend_crates//:base64",
        "@backend_crates//:bytecheck",
        "@backend_crates//:reqwest",
        "@backend_crates//:rkyv",
        "@backend_crates//:semver",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:sha2",
        "@backend_crates//:thiserror",
        "@backend_crates//:tokio",
        "@backend_crates//:tower",
        "@backend_crates//:tower-resilience-coalesce",
        "@backend_crates//:tower-resilience-retry",
        "@backend_crates//:tracing",
        "@backend_crates//:url",
        "@backend_crates//:utoipa",
        "@backend_crates//:wasmtime",
        "@backend_crates//:wasmtime-wasi",
    ],
)

rust_quality_targets(
    targets = [
        ":plugin-host",
        ":test_plugin_host",
        ":test_media_spec",
    ],
)

filegroup(
    name = "wit_files",
    srcs = glob(["wit/*.wit"]),
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
