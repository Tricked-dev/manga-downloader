package manga:source;

interface types {
    enum http-method {
        get,
        post,
        put,
        patch,
        delete,
        head,
        options,
    }

    record http-header {
        name: string,
        value: string,
    }

    enum request-purpose {
        api,
        document,
        image,
        asset,
        custom,
    }

    enum source-capability {
        search,
        manga-details,
        chapter-list,
        page-list,
    }

    record search-options {
        categories: list<string>,
        default-category: option<string>,
        supports-popular-sort: bool,
    }

    record plugin-error {
        code: string,
        message: string,
        retryable: bool,
    }

    record source-metadata {
        id: string,
        name: string,
        base-url: string,
        version: string,
        api-version: u32,
        build-metadata: option<string>,
        homepage: option<string>,
        repository: option<string>,
        capabilities: list<source-capability>,
        search-options: search-options,
    }

    record manga {
        id: string,
        title: string,
        cover: media-ref,
        description: string,
        author: string,
        genres: list<string>,
        status: string,
        is-nsfw: bool,
        alt-titles: list<string>,
    }

    record chapter {
        id: string,
        title: string,
        number: f64,
        volume: option<f64>,
        published-at: string,
    }

    record page {
        index: u32,
        image: media-ref,
    }

    record search-query {
        text: string,
        page: u32,
        category: option<string>,
        popular: bool,
    }

    record search-results {
        items: list<manga>,
        has-next-page: bool,
    }

    record fetch-request {
        url: string,
        method: http-method,
        headers: list<http-header>,
        body: option<string>,
        purpose: request-purpose,
    }

    record fetch-response {
        status: u16,
        headers: list<http-header>,
        body: string,
        final-url: string,
    }

    record browser-json-capture-request {
        url: string,
        init-script: string,
        done-expression: string,
        payloads-expression: string,
        timeout-ms: u32,
        poll-interval-ms: u32,
    }

    record browser-json-capture-response {
        payloads: list<string>,
    }

    record media-ref {
        url: string,
        request: option<fetch-request>,
    }
}

world manga-source {
    use types.{
        chapter,
        browser-json-capture-request,
        browser-json-capture-response,
        fetch-request,
        fetch-response,
        manga,
        media-ref,
        page,
        plugin-error,
        search-query,
        search-results,
        source-metadata,
    };
    import fetch: func(request: fetch-request) -> result<fetch-response, string>;
    import capture-browser-json: func(request: browser-json-capture-request) -> result<browser-json-capture-response, string>;
    export metadata: func() -> source-metadata;
    export search: func(query: search-query) -> result<search-results, plugin-error>;
    export get-manga: func(manga-id: string) -> result<manga, plugin-error>;
    export get-chapters: func(manga-id: string) -> result<list<chapter>, plugin-error>;
    export get-pages: func(chapter-id: string) -> result<list<page>, plugin-error>;
}
