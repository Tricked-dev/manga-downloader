load("@rules_rust//rust:defs.bzl", "rust_library")
load("//libs/bazel/rust:defs.bzl", "rust_quality_targets")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "api-types",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "backend_api_types",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "@backend_crates//:bytecheck",
        "@backend_crates//:rkyv",
        "@backend_crates//:serde",
        "@backend_crates//:serde_json",
        "@backend_crates//:utoipa",
    ],
)

rust_quality_targets(
    targets = [":api-types"],
)

filegroup(
    name = "rust_files",
    srcs = glob(
        [
            "src/**/*.rs",
            "tests/**/*.rs",
        ],
        allow_empty = True,
    ),
    tags = ["rust"],
)

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)
