load("@aspect_rules_js//js:defs.bzl", "js_library", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//libs/svelte/api-client:orval/package_json.bzl", orval = "bin")
load("@npm//libs/svelte/api-client:typescript/package_json.bzl", typescript = "bin")
load("@npm//libs/svelte/api-client:vitest/package_json.bzl", vitest = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages()

filegroup(
    name = "starlark_files",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)

filegroup(
    name = "handwritten_sources",
    srcs = glob(
        [
            "src/**/*.ts",
            "*.json",
            "*.ts",
        ],
        exclude = ["src/generated/**"],
    ),
)

genrule(
    name = "openapi_spec",
    outs = ["openapi/openapi.json"],
    cmd = "$(location //apps/rust/server:openapi_export) > $@",
    tools = ["//apps/rust/server:openapi_export"],
)

orval.orval_binary(
    name = "orval_bin",
    chdir = package_name(),
    data = [":node_modules"],
)

js_run_binary(
    name = "generated_api_client",
    srcs = [
        ":handwritten_sources",
        ":node_modules",
        ":openapi_spec",
    ],
    args = [
        "--config",
        "orval.config.ts",
    ],
    chdir = package_name(),
    env = {
        "ORVAL_OPENAPI_TARGET": "./openapi/openapi.json",
    },
    out_dirs = ["src/generated"],
    tool = ":orval_bin",
)

filegroup(
    name = "sources",
    srcs = [
        ":generated_api_client",
        ":handwritten_sources",
        ":openapi_spec",
    ],
)

js_library(
    name = "pkg",
    srcs = [":sources"],
    deps = [
        ":node_modules/@faker-js/faker",
        ":node_modules/@tanstack/svelte-query",
        ":node_modules/better-result",
        ":node_modules/msw",
    ],
)

js_test(
    name = "lint",
    args = [
        "oxlint",
        "oxlint",
        "libs/svelte/api-client",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_js_ts_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "libs/svelte/api-client",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

js_test(
    name = "format_oxc_json_check",
    args = [
        "oxfmt",
        "oxfmt",
        "--check",
        "libs/svelte/api-client/package.json",
        "libs/svelte/api-client/tsconfig.json",
    ],
    data = [
        ":pkg",
        "//:node_modules",
        "//:root_oxc_files",
    ],
    entry_point = "//:run_npm_bin",
)

typescript.tsc_test(
    name = "typecheck",
    args = [
        "--noEmit",
        "--project",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
)

vitest.vitest_test(
    name = "test",
    args = ["run"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":sources",
    ],
)
