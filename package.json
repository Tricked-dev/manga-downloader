{
  "name": "manga-server-js-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @manga-server/web exec vp dev",
    "dev:kanidm": "pnpm --filter @manga-server/kanidm-manager run dev",
    "bench": "vp run bench:web",
    "build": "vp run build:web",
    "build:kanidm": "pnpm --filter @manga-server/kanidm-manager run build",
    "build:cloudflare": "pnpm --filter @manga-server/web run build:cloudflare",
    "check": "vp run check:all",
    "preview:cloudflare": "pnpm --filter @manga-server/web run preview:cloudflare",
    "deploy:cloudflare": "pnpm --filter @manga-server/web run deploy:cloudflare",
    "deploy:cloudflare:dry-run": "pnpm --filter @manga-server/web run deploy:cloudflare:dry-run",
    "check:svelte": "pnpm --filter @manga-server/web run check:svelte && pnpm --filter @manga-server/kanidm-manager run check:svelte",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @manga-server/api-client run test && pnpm --filter @manga-server/web run test",
    "test:ui": "pnpm --filter @manga-server/web run test:ui"
  },
  "devDependencies": {
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.1.0",
    "pnpm": ">=11.1.3"
  },
  "packageManager": "pnpm@11.1.3"
}
