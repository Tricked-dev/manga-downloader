[
	{
		"type": "group",
		"title": "Server",
		"footer": "Use an address reachable from the device running Aidoku. Search queries every enabled source that supports it.",
		"items": [
			{
				"type": "text",
				"key": "serverBaseUrl",
				"title": "Server URL",
				"placeholder": "https://manga.example.com",
				"keyboardType": 3,
				"returnKeyType": 9,
				"autocorrectionDisabled": true,
				"autocapitalizationType": 0,
				"notification": "serverBaseUrlChanged",
				"refreshes": ["content"]
			}
		]
	},
	{
		"type": "group",
		"title": "Account",
		"footer": "Signing in creates a token for this device, which you can revoke from the server's settings page at any time. The API key is only needed if you would rather paste one in yourself.",
		"items": [
			{
				"type": "login",
				"key": "mangaLogin",
				"title": "Sign In",
				"method": "web",
				"urlKey": "loginUrl",
				"localStorageKeys": ["mangaApiToken"],
				"logoutTitle": "Sign Out",
				"clearCookiesOnLogOut": true,
				"refreshes": ["content"]
			},
			{
				"type": "text",
				"key": "backendApiKey",
				"title": "API Key",
				"placeholder": "Optional",
				"returnKeyType": 9,
				"autocorrectionDisabled": true,
				"autocapitalizationType": 0,
				"refreshes": ["content"]
			}
		]
	}
]
